#include <iostream>
using namespace std;


struct ArrayStack {
    int top = -1;
    char arr[20];

    void push(char val) {
        if (top == -1) {
            arr[0] = val;
            top = 0;
        } else if (top < 4) {
            top++;
            arr[top] = val;
        } else {
            cout << "Stack full" << endl;
        }
    }

    char pop() {
        if (top == -1) {
            cout << "Stack empty" << endl;
            return '\0';
        } else {
            char val = arr[top];
            top--;
            return val;
        }
    }

    void peak() {
        if (top == -1) {
            cout << "Stack empty";
        }else {
            cout << arr[top] << " value at top" << endl;
        }
    }


    void display() {
        int count = 0;
        if (top == -1) {
            cout << "Stack empty";
        }else {
            while (count <= top) {
                cout << arr[count];
                count++;
            }
        }

    }
};

int main() {
    ArrayStack *myStack = new ArrayStack;
    char n;
    char popVal;
    int wlength;

    cout << "Enter length of word in characters: " << endl;
    cin >> wlength;
    for (int i = 0; i < wlength; i++) {
        cout << "Enter character";
        cin >> n;
        myStack->push(n);
    }
    cout << "Reversed word: " << endl;
    for (int i = 0; i < wlength; i++) {
        popVal = myStack->pop();

        cout << popVal;
    }
}
