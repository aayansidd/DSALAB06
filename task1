#include <iostream>
using namespace std;


struct ArrayStack {
    int top = -1;
    int arr[5];

    void push(int val) {
        if (top == -1) {
            arr[0] = val;
            top = 0;
        } else if (top < 4) {
            top++;
            arr[top] = val;
        } else {
            cout << "Stack full" << endl;
        }
    }

    void pop() {
        if (top == -1) {
            cout << "Stack empty";
        }else {
            cout << arr[top] << " value removed" << endl;
            top--;
        }
    }

    void peak() {
        if (top == -1) {
            cout << "Stack empty";
        }else {
            cout << arr[top] << " value at top" << endl;
        }
    }


    void display() {
        int count = 0;
        if (top == -1) {
            cout << "Stack empty";
        }else {
            while (count <= top) {
                cout << arr[count];
                count++;
            }
        }

    }
};

int main() {
    ArrayStack *myStack = new ArrayStack;
    myStack->push(10);
    myStack->push(20);
    myStack->push(30);
    myStack->display();
    myStack->pop();
    myStack->peak();
    myStack->push(40);
    myStack->push(50);
    myStack->push(60);
    myStack->push(30);
    myStack->pop();
    myStack->pop();
    myStack->pop();
    myStack->pop();
    myStack->pop();
    myStack->pop();
}
