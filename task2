#include <iostream>
using namespace std;

struct node {
    int data;
    node *next;
};

struct LinkedStack {
private:
    node *top = nullptr;
public:
    node *temp = nullptr;
    node *next = nullptr;


    void push(int val) {
        node *newnode = new node;
        newnode->data = val;
        newnode->next = top;
        top = newnode;
    }

    void pop() {

        if (top == nullptr) {
            cout << "Stack is empty" << endl;
        }else {
            temp = top;
            top = top->next;
            int popVal = temp->data;

            cout << popVal << " Value is popped" << endl;
            delete temp;
        }

    }

    void peek() {
        if (isEmpty()) {
            cout << "Stack is empty! Nothing to peek." << endl;
            return;
        }
        cout << "Top element: " << top->data << endl;
    }

    bool isEmpty() {
        return top == nullptr;
    }

    void display() {
        temp = top;
        while (temp != nullptr) {
            cout << temp->data << "->";
            temp = temp->next;

        }
        cout << "nullptr" << endl;
    }

    void clearStack() {
        temp = top;
        while (temp != nullptr) {
            next = temp;
            temp = temp->next;
            delete next;
        }
        top = nullptr;

    }
};

int main() {
    LinkedStack stack;



    stack.push(5);
    stack.push(15);
    stack.push(25);


    stack.display();
    stack.pop();
    stack.peek();
    stack.pop();
    stack.pop();
    stack.pop();
    stack.clearStack();

    return 0;
}
