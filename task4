    //     } else {
    //         int val = items[rear];
    //         rear--;
    //         cout << "Value popped: " << val;
    //     }
    // }

    void display() {
        if (rear == -1 && front == -1) {
            cout << "Queue empty" << endl;
            return;
        }

        int curr = front;


        while (curr <= rear) {
            cout << items[curr] << "->";
            curr++;
        }
        cout << "end" << endl;
    }
};

int main() {
    queue myQueue;

    myQueue.enqueue(10);
    myQueue.enqueue(20);
    myQueue.enqueue(30);
    myQueue.display();
    myQueue.enqueue(40);
    myQueue.enqueue(50);
    myQueue.enqueue(30);
}
