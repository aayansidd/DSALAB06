#include <iostream>
using namespace std;

struct queue {
    int items[5];
    int front = -1;
    int rear = - 1;

    void enqueue(int val) {
        if (rear == -1 && front == -1) {
            front = 0;
            rear = 0;
            items[rear] = val;
        } else if (rear < 4) {
            rear++;
            items[rear] = val;
        } else {
            cout << "Queue full" << endl;
        }
    }

    // void removeNode() {
